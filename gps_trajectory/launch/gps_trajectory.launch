<launch>
    <!-- 发布局部坐标系到map的静态TF -->
    <node pkg="tf2_ros" type="static_transform_publisher" 
          name="local_origin_tf" args="0 0 0 0 0 0 map local_origin" />
    
    <node pkg="gps_trajectory" type="gps_trajectory_node" 
          name="trajectory" output="screen"/>

      <!-- 启动RViz -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find gps_trajectory)/rviz/gps.rviz" required="true" output="screen"/>
</launch>